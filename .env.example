# PocketBase 서버 URL. VITE_ 접두어라 브라우저 번들에 노출된다.
# seed 도 이 값을 대상으로 쓰지만 로컬 루프백 PocketBase(localhost, 127.0.0.1, [::1]) 전용이다.
# 운영 데이터는 seed 가 아니라 PocketBase 관리 UI 로 입력한다.
# 로컬 예: http://127.0.0.1:8090
VITE_POCKETBASE_URL=

# seed 전용 superuser 이메일(로컬 루프백 PocketBase 전용). VITE_ 접두어가 없어 브라우저에 노출되지 않는다.
PB_SUPERUSER_EMAIL=

# seed 전용 superuser 비밀번호(로컬 루프백 PocketBase 전용). VITE_ 접두어가 없어 브라우저에 노출되지 않는다.
PB_SUPERUSER_PASSWORD=

# 로컬 Docker PocketBase 의 Google 로그인 OAuth 클라이언트(googleAuth.pb.js 가 서버 시작 때 반영).
DAZBEAT_GOOGLE_CLIENT_ID=
DAZBEAT_GOOGLE_CLIENT_SECRET=

# 탈퇴한 Google 계정의 재가입 차단 목록을 만드는 HMAC 키(서버 전용 비밀값, 32자 이상, 예: openssl rand -hex 32).
# 없거나 짧으면 Google 로그인과 계정 삭제가 거절된다.
DAZBEAT_REJOIN_BLOCK_HMAC_KEY=

# 교체 전에 쓰던 은퇴 키 목록(쉼표 구분, 각 32자 이상). 그 키로 만든 차단 행이 남아 있는 한 보관한다.
# 차단 행의 키가 현재 키와 이 목록에 없으면 Google 로그인과 계정 삭제가 거절된다.
DAZBEAT_REJOIN_BLOCK_HMAC_RETIRED_KEYS=
